{
  "name": "open-review",
  "version": "0.5.0",
  "type": "module",
  "bin": {
    "open-review": "dist/main.mjs"
  },
  "main": "dist/main.mjs",
  "types": "dist/main.d.ts",
  "scripts": {
    "build": "tsdown src/main.ts src/local-bridge.ts --format esm --no-dts && tsc --emitDeclarationOnly --declarationMap false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openreview/core": "workspace:*",
    "@types/express": "^5.0.6",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "ora": "^8.2.0"
  }
}
