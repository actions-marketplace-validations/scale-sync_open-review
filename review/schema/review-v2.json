{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/scale-sync/open-review/blob/main/review/schema/review-v2.json",
  "title": "open-review local review contract v2",
  "$defs": {
    "hunk": {
      "type": "object",
      "required": ["oldStart", "oldCount", "newStart", "newCount", "lines"],
      "properties": {
        "oldStart": { "type": "integer" },
        "oldCount": { "type": "integer" },
        "newStart": { "type": "integer" },
        "newCount": { "type": "integer" },
        "lines": { "type": "array", "items": { "type": "string" } }
      }
    },
    "change": {
      "type": "object",
      "required": ["path", "status", "binary", "patch", "hunks"],
      "properties": {
        "path": { "type": "string" },
        "oldPath": { "type": "string" },
        "status": {
          "enum": ["added", "modified", "deleted", "renamed", "copied", "type_changed", "unmerged"]
        },
        "untracked": { "type": "boolean" },
        "inputIssue": { "type": "string" },
        "binary": { "type": "boolean" },
        "patch": { "type": "string" },
        "hunks": { "type": "array", "items": { "$ref": "#/$defs/hunk" } }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["path", "status", "state", "patchBytes", "sentBytes"],
      "properties": {
        "path": { "type": "string" },
        "oldPath": { "type": "string" },
        "status": { "type": "string" },
        "state": { "enum": ["selected", "reviewed", "partial", "failed", "skipped"] },
        "reason": { "type": "string" },
        "patchBytes": { "type": "integer", "minimum": 0 },
        "sentBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "request": {
      "type": "object",
      "required": ["contractVersion", "mode", "repoRoot", "diff", "files"],
      "properties": {
        "contractVersion": { "const": 2 },
        "mode": { "enum": ["workspace", "branch", "commit"] },
        "repoRoot": { "type": "string" },
        "baseRef": { "type": "string" },
        "headRef": { "type": "string" },
        "baseSha": { "type": "string" },
        "mergeBaseSha": { "type": "string" },
        "headSha": { "type": "string" },
        "commitSha": { "type": "string" },
        "parents": { "type": "array", "items": { "type": "string" } },
        "diff": { "type": "string" },
        "files": { "type": "array", "items": { "type": "string" } },
        "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } },
        "coverage": { "type": "array", "items": { "$ref": "#/$defs/coverage" } }
      }
    }
  },
  "type": "object",
  "required": ["contractVersion", "status", "request", "coverage", "findings"],
  "properties": {
    "contractVersion": { "const": 2 },
    "status": { "enum": ["empty", "skipped", "complete", "failed"] },
    "request": { "$ref": "#/$defs/request" },
    "coverage": { "type": "array", "items": { "$ref": "#/$defs/coverage" } },
    "findings": { "type": "array", "items": { "type": "object" } },
    "summary": { "type": "object" },
    "trace": { "type": "object" },
    "error": { "type": "string" }
  }
}
