{
  "name": "open-review-workspace",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Open-source agentic code review tool — AI-powered bug detection, sandboxed execution, codebase-aware chat, full GitHub sync",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "oxlint --type-aware core cli action tests",
    "lint:fix": "oxlint --type-aware --fix core cli action tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "review": "go run ./cmd/open-review review"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@langchain/anthropic": "^0.3.34",
    "@langchain/core": "^0.3.80",
    "@langchain/google-genai": "^0.2.18",
    "@langchain/langgraph": "^0.2.74",
    "@langchain/openai": "^0.4.9",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "axios": "^1.13.6",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.8.1",
    "tsdown": "^0.21.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "zod": "^4.3.6"
  }
}
