# OpenReview per-repo config — copy to `.reviewbuddy.yaml` at your repo root
# and commit it. Every field is optional; omit what you don't need.
#
# Review guidance order: built-in, local CLI user rules, repository files,
# then an explicit run instruction. The Action reads this file at the PR head.

# chill   — only report severe/non-severe bugs; skip informational and
#           purely stylistic "investigate" flags unless they carry real risk.
# assertive (default) — today's thorough behavior, unchanged.
profile: assertive

# Extra review guidance applies only to matching files. Use mode: replace
# to discard lower-priority guidance for those files; merge is the default.
path_instructions: []
# path_instructions:
#   - path: 'apps/web/**'
#     instructions: Favor accessibility findings over micro-optimizations.
#     mode: merge
#   - path: 'packages/api/**'
#     instructions: Flag any handler missing an auth check.

# Freeform guidance on how to categorize/label findings.
labeling_instructions: ''
# labeling_instructions: >
#   Treat lint-fixable style issues as informational, not investigate.

# Appended as a closing line on every review summary comment.
finishing_touches: ''
# finishing_touches: '— reviewed by OpenReview'
